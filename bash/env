PATH=$PATH:/usr/local/bin
PATH=$PATH:/snap/bin
PATH=$PATH:$HOME/.fzf/bin
PATH=$PATH:$HOME/.rbenv/bin
PATH=$PATH:$HOME/.rbenv/plugins/ruby-build/bin
PATH=$PATH:$HOME/.cargo/bin
PATH=$PATH:/usr/lib/ruby/gems/3.0.0
PATH=$PATH:/opt/Garmin/bin
if [ -f "$HOME/.Garmin/ConnectIQ/current-sdk.cfg" ]; then
  PATH="$PATH:$(cat $HOME/.Garmin/ConnectIQ/current-sdk.cfg)bin"
fi
export PATH="$HOME/.jenv/shims:$PATH"
export PATH

export EDITOR="vim"
export GPG_TTY=$(tty)

export FZF_DEFAULT_COMMAND='
  ({ git ls-files -m -c & git ls-files -o --exclude-standard; }  ||
   find . -path "*/\.*" -prune -o -type f -print -o -type l -print |
      sed s/^..//) | sort | uniq 2> /dev/null'

export GDK_BACKEND=wayland

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

export PNPM_HOME="/home/jiri/.local/share/pnpm"
export PATH="$PNPM_HOME:$PATH"

if ! pgrep -u "$USER" ssh-agent > /dev/null; then
    ssh-agent -t 1h > "$XDG_RUNTIME_DIR/ssh-agent.env"
fi
if [[ ! -f "$SSH_AUTH_SOCK" ]]; then
    source "$XDG_RUNTIME_DIR/ssh-agent.env" >/dev/null
fi

export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init - zsh)"

eval "$(jenv init -)"
